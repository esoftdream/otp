{
    "name": "esoftdream/otp",
    "description": "Library kelola OTP",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com"
        }
    ],
    "require": {
        "codeigniter4/framework": "^4",
        "doctrine/instantiator": "^1.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Esoftdream\\OTP\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9"
    }
}